{
  "name": "pantunes.dev",
  "version": "1.0.0",
  "description": "Portfolio of Paulo Antunes — static PHP templates, Vercel Functions and an MCP server",
  "author": "Paulo Antunes",
  "homepage": "https://pantunes.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/paulogabriel/pantunes.dev"
  },
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@accessible360/accessible-slick": "1.0.1",
    "@babel/core": "^7.14.3",
    "@babel/preset-env": "^7.14.2",
    "@vercel/analytics": "^2.0.1",
    "babel-loader": "^8.2.2",
    "browserslist-config-google": "^3.0.1",
    "nodemailer": "^10.0.10",
    "normalize.css": "^8.0.1",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.2.15",
    "prettier": "^2.4.1",
    "webpack": "^5.37.1",
    "webpack-cli": "^4.7.0",
    "what-input": "^5.2.10"
  },
  "browserslist": [
    "extends browserslist-config-google"
  ],
  "scripts": {
    "build": "npx sass sass/main.scss dist/main.css --style=compressed && npx webpack --config webpack.config.js && php scripts/build-html.php",
    "format": "run-p format:*",
    "format:js": "npx prettier --write js/",
    "format:sass": "npx prettier --write sass/",
    "resume": "node scripts/build-resume.js"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "cssnano": "^6.1.2",
    "playwright-core": "^1.59.1",
    "sass": "^1.87.0"
  }
}
